# Supabase konfiguracija (self-hosted stack preko Tailscale Funnel :8443 -> lokalni Kong :54321)
SUPABASE_URL=https://your-host.tailxxxx.ts.net:8443
SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY i LOCAL_JWT_SECRET drzati u .env.admin — NIKADA u ovom fajlu (bundle-uje se u app).

# OSRM ruting konfiguracija (nije AI, koristi se za ETA i optimizaciju redosleda)
# Primer: OSRM_BASE_URL=http://192.168.x.x:5000
# OSRM_BASE_URL=

# API kljuc za zastitu OSRM reverse proxy-ja (mora biti isti u proxy-ju i edge funkcijama).
GAVRA013_API_KEY=
